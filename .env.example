# ============================================================
# Variáveis de ambiente — Marina Assistente (Alpha 1)
# ============================================================

# ---- Sessão (obrigatório em produção) ----
# Gere com: openssl rand -hex 32   (mínimo 32 caracteres)
SESSION_SECRET=

# ---- Banco (Supabase Postgres) ----
POSTGRES_URL=
# Fallback opcional (conexão direta, sem pooler):
# POSTGRES_URL_NON_POOLING=

# ============================================================
# Motor de IA — endpoint compatível com OpenAI
# Hoje: Hugging Face (router ou Inference Endpoint dedicado).
# ============================================================
# Provedor (mesma base e chave para todos os modelos)
OPENAI_BASE_URL=https://router.huggingface.co/v1
OPENAI_MODEL=deepseek-ai/deepseek-v4-pro
OPENAI_API_KEY=hf_xxxxxxxxxxxxxxxx

# ---- Failover ENTRE MODELOS do HF (opcional) ----
# Se o modelo principal falhar (timeout/erro/5xx), o /api/chat tenta os
# próximos desta lista (separados por vírgula), na mesma base/chave do HF.
# OPENAI_MODEL_FALLBACKS=meta-llama/Llama-3.3-70B-Instruct, Qwen/Qwen2.5-72B-Instruct

# ============================================================
# Rate limiting global (opcional — Upstash Redis)
# Sem isto, o limite é por instância (em memória).
# ============================================================
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
