# ====== Mangaba (IA GRATUITA, local) — padrão ======
# Não precisa de chave de API. Basta ter o Mangaba rodando (`mangaba serve`).
# Mesmo fluxo do Ollama: API OpenAI-compatible em http://localhost:11434/v1.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=mangaba-pro
# OPENAI_API_KEY não é necessária com Mangaba.

# ====== Alternativa gratuita HOSPEDADA (funciona na Vercel sem túnel) ======
# Groq tem nível gratuito e é compatível com OpenAI:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=gsk_xxxxxxxxxxxxxxxx

# ====== OpenAI (pago) ======
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
