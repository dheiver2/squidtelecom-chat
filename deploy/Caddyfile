# Caddyfile — proxy HTTPS + autenticação Bearer para o Ollama da VPS.
# O Caddy obtém e renova o certificado TLS automaticamente (Let's Encrypt),
# desde que o domínio aponte (A/AAAA) para o IP da VPS e as portas 80/443 estejam abertas.
#
# Como usar:
#   1) Troque "ia.seudominio.com" pelo seu domínio.
#   2) Gere uma chave forte:  openssl rand -hex 32
#      e substitua TODAS as ocorrências de SUA_CHAVE_LONGA_AQUI.
#   3) Suba:  caddy run --config ./Caddyfile   (ou via serviço systemd do Caddy)
#
# Essa MESMA chave vai em OPENAI_API_KEY nas variáveis de ambiente da Vercel.

alpha1-ia.duckdns.org {
	# Bloqueia qualquer requisição que NÃO traga o header exato:
	#   Authorization: Bearer SUA_CHAVE_LONGA_AQUI
	# (o Ollama não tem autenticação nativa; a auth é feita aqui no proxy)
	# >>> troque SUA_CHAVE_LONGA_AQUI pela chave real SÓ nesta cópia da VPS <<<
	@semchave {
		not header Authorization "Bearer SUA_CHAVE_LONGA_AQUI"
	}
	respond @semchave "Unauthorized" 401

	# Ollama escuta só em 127.0.0.1:11434 (não exposto à internet).
	# O Caddy, na mesma VPS, encaminha as requisições já autenticadas.
	reverse_proxy 127.0.0.1:11434 {
		# Streaming (SSE) precisa de flush imediato — sem buffering.
		flush_interval -1
	}

	# Logs (opcional)
	log {
		output file /var/log/caddy/ia.access.log
	}
}
